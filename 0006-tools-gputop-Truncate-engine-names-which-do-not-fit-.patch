From 4e11b991fd0ac10351d2bc55deea1d53bfbc745c Mon Sep 17 00:00:00 2001
From: Erik Berg <gitlab@slipsprogrammor.no>
Date: Sun, 27 Sep 2026 00:19:30 +0200
Subject: [PATCH i-g-t 06/12] tools/gputop: Truncate engine names which do not
 fit their column

Engine names wider than the per-engine column are simply skipped in
the header, while the corresponding percentage bar is still printed
for every client row. On i915 with an 80 column terminal this shows
three engine names above four bars, since "video-enhance" does not
fit, and the NAME heading ends up shifted as well.

Truncate the name to the column width instead. With the column never
narrower than a bar the header now always lines up with the rows.

Assisted-by: Claude:claude-fable-5-1
Signed-off-by: Erik Berg <gitlab@slipsprogrammor.no>
---
 tools/gputop.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/tools/gputop.c b/tools/gputop.c
index 8b3bb67a7..b0d9a96a6 100644
--- a/tools/gputop.c
+++ b/tools/gputop.c
@@ -321,17 +321,18 @@ print_client_header(struct igt_drm_client *c, int lines, int con_w, int con_h,
 			if (!name)
 				continue;
 
-			name_len = strlen(name);
+			/*
+			 * Truncate names wider than the column so the header
+			 * stays aligned with the per-engine bars below it.
+			 */
+			name_len = min_t(int, strlen(name), width);
 			pad = (width - name_len) / 2;
 			spaces = width - pad - name_len;
 
-			if (pad < 0 || spaces < 0)
-				continue;
-
 			n_spaces(pad);
-			printf("%s", name);
+			printf("%.*s", name_len, name);
 			n_spaces(spaces);
-			len += pad + name_len + spaces;
+			len += width;
 		}
 	}
 
