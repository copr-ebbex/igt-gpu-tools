From 37885394864d1bf2a134a1bb59beca332e5115f5 Mon Sep 17 00:00:00 2001
From: Erik Berg <gitlab@slipsprogrammor.no>
Date: Sun, 27 Sep 2026 00:19:31 +0200
Subject: [PATCH i-g-t 09/12] tools/gputop: Detect the bound driver once per
 header

Printing a client header reads the device/driver symlink up to three
times: is_intel_device() tries both driver names to decide whether the
device is an Intel one at all, and detect_intel_driver() then tries
them again to tell i915 and xe apart. The two steps ask the same
question.

Have detect_intel_driver() read the symlink once and compare the driver
name against both, and let get_frequencies() pass the result down to
get_intel_frequencies(). This removes is_bound() and is_intel_device()
and leaves a single readlink() per header. No change in output.

Assisted-by: Claude:claude-fable-5-1
Signed-off-by: Erik Berg <gitlab@slipsprogrammor.no>
---
 tools/gputop.c | 39 ++++++++++++---------------------------
 1 file changed, 12 insertions(+), 27 deletions(-)

diff --git a/tools/gputop.c b/tools/gputop.c
index 74415fb80..0fa51b56c 100644
--- a/tools/gputop.c
+++ b/tools/gputop.c
@@ -135,8 +135,8 @@ static bool get_card_minor(unsigned int drm_minor, unsigned int *card_minor)
 	return found;
 }
 
-/* Detect if driver is bound to the device */
-static bool is_bound(unsigned int drm_minor, const char *driver_name)
+/* Detect which Intel driver, if any, is bound to the device */
+static enum intel_driver_type detect_intel_driver(unsigned int drm_minor)
 {
 	char path[256];
 	char link[256];
@@ -148,32 +148,20 @@ static bool is_bound(unsigned int drm_minor, const char *driver_name)
 		 get_sysfs_drm_path(drm_minor), drm_minor);
 	len = readlink(path, link, sizeof(link) - 1);
 	if (len == -1)
-		return false;
+		return INTEL_DRIVER_UNKNOWN;
 
 	link[len] = '\0';
 
 	/* Extract driver name from path (e.g., "bus/pci/drivers/i915" -> "i915") */
 	driver = strrchr(link, '/');
 	if (!driver)
-		return false;
+		return INTEL_DRIVER_UNKNOWN;
 
 	driver++; /* Skip the '/' */
 
-	return strcmp(driver, driver_name) == 0;
-}
-
-/* Detect if this is an Intel device (i915 or Xe) */
-static bool is_intel_device(unsigned int drm_minor)
-{
-	return is_bound(drm_minor, "i915") || is_bound(drm_minor, "xe");
-}
-
-/* Detect Intel driver variant */
-static enum intel_driver_type detect_intel_driver(unsigned int drm_minor)
-{
-	if (is_bound(drm_minor, "xe"))
+	if (!strcmp(driver, "xe"))
 		return INTEL_DRIVER_XE;
-	else if (is_bound(drm_minor, "i915"))
+	if (!strcmp(driver, "i915"))
 		return INTEL_DRIVER_I915;
 
 	return INTEL_DRIVER_UNKNOWN;
@@ -225,20 +213,15 @@ static bool read_freq_value(const char *path, unsigned int *freq)
 }
 
 /* Intel-specific frequency reading for i915/Xe drivers */
-static char *get_intel_frequencies(unsigned int drm_minor)
+static char *get_intel_frequencies(unsigned int drm_minor,
+				   enum intel_driver_type driver_type)
 {
 	char freq_str[512] = "";
 	char gt_info[64];
 	int num_gts;
 	int gt;
-	enum intel_driver_type driver_type;
 	bool first = true;
 
-	/* Detect Intel driver variant */
-	driver_type = detect_intel_driver(drm_minor);
-	if (driver_type == INTEL_DRIVER_UNKNOWN)
-		return NULL;
-
 	/* Get GT count from sysfs */
 	num_gts = get_num_gts(drm_minor, driver_type);
 	if (num_gts == 0)
@@ -297,14 +280,16 @@ static char *get_intel_frequencies(unsigned int drm_minor)
 /* Generic wrapper for frequency reading - dispatches to vendor-specific implementations */
 static char *get_frequencies(unsigned int drm_minor)
 {
+	enum intel_driver_type intel_driver;
 	unsigned int card_minor;
 
 	if (!get_card_minor(drm_minor, &card_minor))
 		return NULL;
 
 	/* Check for Intel devices (i915/Xe) */
-	if (is_intel_device(card_minor))
-		return get_intel_frequencies(card_minor);
+	intel_driver = detect_intel_driver(card_minor);
+	if (intel_driver != INTEL_DRIVER_UNKNOWN)
+		return get_intel_frequencies(card_minor, intel_driver);
 
 	return NULL;
 }
