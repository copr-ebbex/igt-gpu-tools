From d252bc3b42d9a1d29fb36a2896d13094eac20c9f Mon Sep 17 00:00:00 2001
From: Erik Berg <gitlab@slipsprogrammor.no>
Date: Sun, 27 Sep 2026 00:19:29 +0200
Subject: [PATCH i-g-t 04/12] tools/gputop: Fix NULL dereferences on sparse
 engine names

The igt_drm_clients engine name array may contain NULL entries when
engine ids are not contiguous, which the library allows for through its
engine map facility. print_client_header() calls strlen() on the name
before checking it for NULL, and engines_identical() only compares the
NULL-ness of the two names before passing both to strcmp(), which
crashes when both are NULL.

gputop does not pass an engine map, so the parser assigns contiguous
ids and neither can happen today. This is a defensive fix against the
library's documented behaviour rather than a reported crash.

In the header, check the name for NULL before using it. In
engines_identical() key off the engine capacity instead, as the rest of
the code does: the library only fills in a name for slots with a
non-zero capacity, so once the capacities are known to be equal a zero
capacity means the slot is unused by both clients and there is nothing
to compare.

Assisted-by: Claude:claude-fable-5-1
Signed-off-by: Erik Berg <gitlab@slipsprogrammor.no>
---
 tools/gputop.c | 22 +++++++++++++++-------
 1 file changed, 15 insertions(+), 7 deletions(-)

diff --git a/tools/gputop.c b/tools/gputop.c
index cdd0b93aa..a8f90e3fd 100644
--- a/tools/gputop.c
+++ b/tools/gputop.c
@@ -307,13 +307,15 @@ print_client_header(struct igt_drm_client *c, int lines, int con_w, int con_h,
 
 		for (i = 0; i <= c->engines->max_engine_id; i++) {
 			const char *name = c->engines->names[i];
-			int name_len = strlen(name);
-			int pad = (width - name_len) / 2;
-			int spaces = width - pad - name_len;
+			int name_len, pad, spaces;
 
 			if (!name)
 				continue;
 
+			name_len = strlen(name);
+			pad = (width - name_len) / 2;
+			spaces = width - pad - name_len;
+
 			if (pad < 0 || spaces < 0)
 				continue;
 
@@ -339,12 +341,18 @@ engines_identical(const struct igt_drm_client *c,
 	    c->engines->max_engine_id != pc->engines->max_engine_id)
 		return false;
 
-	for (i = 0; i <= c->engines->max_engine_id; i++)
-		if (c->engines->capacity[i] != pc->engines->capacity[i] ||
-		    !!c->engines->names[i] != !!pc->engines->names[i] ||
-		    strcmp(c->engines->names[i], pc->engines->names[i]))
+	for (i = 0; i <= c->engines->max_engine_id; i++) {
+		if (c->engines->capacity[i] != pc->engines->capacity[i])
 			return false;
 
+		/* Equal capacity of zero means the slot is unused by both. */
+		if (!c->engines->capacity[i])
+			continue;
+
+		if (strcmp(c->engines->names[i], pc->engines->names[i]))
+			return false;
+	}
+
 	return true;
 }
 
